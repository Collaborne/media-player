{
	"name": "@collaborne/media-player",
	"version": "4.0.3",
	"description": "Customizable React media player that uses @mui design system and own functionality",
	"author": "Collaborne",
	"license": "Apache-2.0",
	"repository": "Collaborne/media-player",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"source": "src/index.ts",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "npm run build:ts --",
		"build:locales": "node --experimental-strip-types tasks/prepare-locales.ts .storybook/locales",
		"clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
		"prebuild:ts": "npm run clean",
		"build:ts": "tsc -p tsconfig.dist.json --noEmit false",
		"build:watch": "npm run build -- --watch",
		"lint": "npm run lint:ts",
		"lint:ts": "eslint --report-unused-disable-directives src .storybook tasks eslint.config.mjs jest.config.mjs",
		"test": "run-s lint test:build test:unit",
		"test:build": "npm run build:locales && tsc --noEmit -p tsconfig.test.json && npm run build && npm run test:package",
		"test:package": "node --input-type=module -e \"import('@collaborne/media-player').then(module => console.log('ESM package import:', Object.keys(module).length, 'exports'))\"",
		"test:unit": "cross-env CI=1 SKIP_PREFLIGHT_CHECK=true NODE_OPTIONS=--experimental-vm-modules jest --no-watchman --",
		"test:watch": "cross-env SKIP_PREFLIGHT_CHECK=true npx jest --",
		"predeploy": "run-s storybook:build",
		"deploy": "gh-pages -d gh-pages-dist",
		"storybook": "npm run build:locales && NODE_OPTIONS=\"${NODE_OPTIONS} --openssl-legacy-provider\" FAST_REFRESH=false storybook dev -p 9009",
		"storybook:build": "npm run build:locales && NODE_OPTIONS=\"${NODE_OPTIONS} --openssl-legacy-provider\" storybook build --quiet -o gh-pages-dist"
	},
	"peerDependencies": {
		"@mui/material": "^9.5.0",
		"color-blend": "^4.0.0",
		"lodash": "^4.18.1",
		"react": "^17.0.0 || ^18.0.0 || ^19.0.0",
		"react-icons": "^5.7.0",
		"react-player": "^3.4.0",
		"react-transition-group": "^4.4.5",
		"react-use": "^17.6.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/plugin-transform-runtime": "^7.29.7",
		"@babel/runtime": "^7.29.7",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/material": "^9.5.0",
		"@rolldown/plugin-babel": "^0.2.4",
		"@storybook/react": "^10.6.2",
		"@storybook/react-vite": "^10.6.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.17.26",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"@vitejs/plugin-react": "^6.1.2",
		"cross-env": "^10.1.0",
		"eslint": "^10.12.0",
		"eslint-config-collaborne": "^6.0.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.17.0",
		"eslint-plugin-jest": "^29.17.0",
		"eslint-plugin-n": "^18.4.1",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"gh-pages": "^6.3.0",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"mkdirp": "^3.0.1",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.9.10",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-icons": "^5.7.0",
		"react-player": "^3.4.0",
		"react-intl-universal": "2.14.0",
		"storybook": "^10.6.2",
		"ts-jest": "^29.4.14",
		"tsconfig-collaborne": "^1.10.3",
		"tss-react": "^4.9.21",
		"typescript": "^6.0.3",
		"vite": "^8.3.4"
	},
	"files": [
		"dist",
		"locales",
		"src",
		"tsconfig.json"
	],
	"dependencies": {
		"mitt": "^3.0.1",
		"react-rnd": "^10.5.3",
		"react-use": "^17.6.0",
		"resize-observer-polyfill": "^1.5.1",
		"screenfull": "^6.0.2",
		"use-sync-external-store": "^1.7.0",
		"zustand": "^5.0.15"
	}
}
